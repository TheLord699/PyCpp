{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PyCPP",
  "scopeName": "source.pycpp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pycpp",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pycpp",
          "match": "\\b(if|elif|else|for|while|break|continue|return|assert|use|unsafe)\\b"
        },
        {
          "name": "keyword.operator.pycpp",
          "match": "(=|\\+|\\-|\\*|/|%|\\+=|\\-=|\\*=|/=|==|!=|<|>|<=|>=|&|\\*)"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.function.pycpp",
          "match": "\\b(def)\\b"
        },
        {
          "name": "storage.type.class.pycpp",
          "match": "\\b(class|struct)\\b"
        },
        {
          "name": "storage.modifier.pycpp",
          "match": "\\b(constexpr|const)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.pycpp",
          "match": "\\b(int|i8|i16|i32|i64|float|double|f32|f64|bool|str|void|list|dict)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.pycpp",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.boolean.pycpp",
          "match": "\\b(True|False)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pycpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pycpp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pycpp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pycpp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.pycpp",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}