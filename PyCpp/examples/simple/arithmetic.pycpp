def main() -> int:
    print(7 / 2)
    print(7 // 2)
    print(-7 // 2)
    print(-7 % 3)
    print(2 ** 10)

    x: int = 17
    x //= 5
    print(x)

    print(True)
    print(1 == 2)
    print(3.0)

    nums: list[int] = [1, 2, 3]
    print(nums)

    names: dict[str, int] = {"a": 1, "b": 2}
    print(names)

    empty: dict[str, int] = dict()
    print(len(empty))

    return 0
