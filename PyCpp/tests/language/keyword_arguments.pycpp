# expect-exit: 0
# expect-stdout: 12 18 18 24
# expect-stdout: a 5
def box(w: int, h: int = 2, d: int = 3) -> int:
    return w * h * d

class Player:
    def __init__(self, name: str, hp: int = 10):
        self.name: str = name
        self.hp: int = hp

def main() -> int:
    print(box(2), box(2, 3), box(2, h=3), box(w=2, h=3, d=4))
    p = Player(hp=5, name="a")
    print(p.name, p.hp)
    return 0
