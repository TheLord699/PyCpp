use <raylib.h>

class Player:
    def __init__(self, start_x: float, start_y: float, size: float):
        self.x: float = start_x
        self.y: float = start_y
        self.size: float = size
        self.speed: float = 6.0
        self.score: int = 0
        
        self.vel_y: float = 0.0
        self.gravity: float = 0.8
        self.jump_force: float = -15.0
        self.floored: bool = False

    def jump(self) -> void:
        self.vel_y = self.jump_force
        self.floored = False

    def update_controls(self) -> void:
        if (IsKeyDown(KEY_LEFT) or IsKeyDown(KEY_A)) and self.x > 0:
            self.x -= self.speed
        if (IsKeyDown(KEY_RIGHT) or IsKeyDown(KEY_D)) and self.x < 800 - self.size:
            self.x += self.speed
        
        if (IsKeyPressed(KEY_SPACE) or IsKeyPressed(KEY_W) or IsKeyPressed(KEY_UP)) and self.floored:
            self.jump()

    def apply_gravity(self) -> void:
        self.vel_y += self.gravity
        self.y += self.vel_y

        if self.y >= 600 - self.size:
            self.y = 600 - self.size
            self.vel_y = 0.0
            self.floored = True
        
    def update(self) -> void:
        self.update_controls()
        self.apply_gravity()

    def draw(self) -> void:
        DrawRectangle(int(self.x), int(self.y), int(self.size), int(self.size), BLUE)

    def get_rect(self) -> Rectangle:
        return Rectangle(self.x, self.y, self.size, self.size)
