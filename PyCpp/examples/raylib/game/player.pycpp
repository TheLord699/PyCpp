use <raylib.h>
from entity import Entity
from vec2 import Vec2

class Player(Entity):
    def __init__(self, start_pos: Vec2):
        # Call the parent constructor manually (PyCPP doesn't have super() yet)
        self.pos: Vec2 = start_pos
        self.size: float = 40.0
        self.color: Color = BLUE
        self.active: bool = true
        self.speed: float = 6.0
        self.shoot_cooldown: float = 0.0

    def update(self, delta: float) -> void:
        if IsKeyDown(KEY_LEFT) and self.pos.x > 0:
            self.pos.x -= self.speed
        if IsKeyDown(KEY_RIGHT) and self.pos.x < 800 - self.size:
            self.pos.x += self.speed
            
        if self.shoot_cooldown > 0:
            self.shoot_cooldown -= delta