# expect-exit: 0
# expect-no-stderr: warning
# expect-stdout: 5 2.5 hi True 3.5 [1, 2] {'k': 1} 2
class Point:
    def __init__(self, x: int, y: int):
        self.x: int = x
        self.y: int = y

def main() -> int:
    n = 5
    f = 2.5
    s = "hi"
    b = n > 2
    avg = 7 / 2
    xs = [1, 2]
    d = {"k": 1}
    p = Point(1, 2)
    n = n + 0
    print(n, f, s, b, avg, xs, d, p.y)
    return 0
