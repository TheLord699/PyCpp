        print("[FAIL] Classes")
        failed += 1

    if test_structs():
        print("[PASS] Structs")
        passed += 1
    else:
        print("[FAIL] Structs")
        failed += 1

    if test_lists():
        print("[PASS] Lists")
        passed += 1
    else:
        print("[FAIL] Lists")
        failed += 1

    if test_dictionaries():
        print("[PASS] Dictionaries")
        passed += 1
    else:
        print("[FAIL] Dictionaries")
        failed += 1

    if test_templates():
        print("[PASS] Templates")
        passed += 1
    else:
        print("[FAIL] Templates")
        failed += 1

    if test_generic_classes():
        print("[PASS] Generic classes")
        passed += 1
    else:
        print("[FAIL] Generic classes")
        failed += 1

    if test_constexpr():
        print("[PASS] Constexpr")
        passed += 1
    else:
        print("[FAIL] Constexpr")
        failed += 1

    if test_pointers():
        print("[PASS] Pointers")
        passed += 1
