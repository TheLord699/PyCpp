use <raylib.h>
from vec2 import Vec2
from player import Player
from enemy import Enemy
from bullet import Bullet

def main() -> int:
    SetConfigFlags(FLAG_VSYNC_HINT)
    InitWindow(800, 600, "PyCPP Space Defender")
    SetTargetFPS(60)

    # Use a list to hold our enemies and bullets
    enemies: list[Enemy] = []
    bullets: list[Bullet] = []

    hero: Player = Player(Vec2(380.0, 540.0))
    spawn_timer: float = 0.0
    game_over: bool = false

    while !WindowShouldClose():
        # Calculate delta time in seconds
        delta: float = GetFrameTime()

        if game_over == false:
            hero.update(delta)
            
            # --- SHOOTING ---
            if IsKeyDown(KEY_SPACE) and hero.shoot_cooldown <= 0:
                bullets.append(Bullet(Vec2(hero.pos.x + 17.0, hero.pos.y - 10.0)))
                hero.shoot_cooldown = 0.2

            # --- SPAWN ENEMIES ---
            spawn_timer += delta
            if spawn_timer > 1.0:
                spawn_timer = 0.0
                random_x: float = float(GetRandomValue(0, 770))
                enemies.append(Enemy(Vec2(random_x, -30.0)))

            # --- UPDATE BULLETS ---
            for b in bullets:
                b.update(delta)
            
            # --- UPDATE ENEMIES ---
            for e in enemies:
                e.update(delta)

            # --- CHECK COLLISIONS ---
            for b in bullets:
                for e in enemies:
                    if b.active and e.active and CheckCollisionRecs(b.get_rect(), e.get_rect()):
                        b.active = false
                        e.active = false

            for e in enemies:
                if e.active and CheckCollisionRecs(hero.get_rect(), e.get_rect()):
                    game_over = true

            # --- CLEANUP ---
            # Filter out inactive bullets and enemies
            # PyCPP doesn't have list comprehensions yet, so we do it manually
            active_bullets: list[Bullet] = []
            for b in bullets:
                if b.active:
                    active_bullets.append(b)
            bullets = active_bullets

            active_enemies: list[Enemy] = []
            for e in enemies:
                if e.active:
                    active_enemies.append(e)
            enemies = active_enemies

        # --- DRAW ---
        BeginDrawing()
        ClearBackground(BLACK)

        if game_over:
            DrawText("GAME OVER", 250, 280, 40, RED)
            DrawText("Press ESC to quit", 280, 330, 20, LIGHTGRAY)
        else:
            hero.draw()
            for b in bullets:
                b.draw()
            for e in enemies:
                e.draw()

        EndDrawing()

    CloseWindow()
    return 0