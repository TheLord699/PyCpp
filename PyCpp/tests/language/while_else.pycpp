# expect-exit: 0
# expect-stdout: loop finished
# expect-stdout: 2
# expect-no-stdout: never printed
def main() -> int:
    n: int = 0
    while n < 3:
        n += 1
    else:
        print("loop finished")

    i: int = 0
    while i < 5:
        if i == 2:
            break
        i += 1
    else:
        print("never printed")
    print(i)
    return 0
