# expect-exit: 0
# expect-stdout: Point(1, 2)
# expect-stdout: p = Point(1, 2)
class Point:
    def __init__(self, x: int, y: int):
        self.x: int = x
        self.y: int = y

    def __str__(self) -> str:
        return f"Point({self.x}, {self.y})"

def main() -> int:
    p = Point(1, 2)
    print(p)
    print(f"p = {p}")
    print(str(p))
    return 0
