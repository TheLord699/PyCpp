from player import Player
from enemy import Enemy
use <raylib.h>

def main() -> int:
    SetConfigFlags(FLAG_VSYNC_HINT)
    InitWindow(800, 600, "PyCPP Multi-File Dodge")
    SetTargetFPS(60)

    hero: Player = Player(400.0, 550.0, 40.0)
    hazard: Enemy = Enemy(400.0, 40.0, 4.0)

    game_over: bool = false

    while WindowShouldClose() == false:
        if game_over == false:
            hero.update()
            hazard.update(hero)

            if CheckCollisionRecs(hero.get_rect(), hazard.get_rect()):
                game_over = true
        else:
            if IsKeyPressed(KEY_R):
                hero = Player(400.0, 550.0, 40.0)
                hazard = Enemy(400.0, 40.0, 4.0)
                game_over = false

        BeginDrawing()
        ClearBackground(BLACK)

        if game_over:
            DrawText("GAME OVER", 250, 280, 40, RED)
            DrawText("Press R to Restart or ESC to quit", 200, 330, 20, LIGHTGRAY)
        else:
            hero.draw()
            hazard.draw()
            DrawText(TextFormat("Score: %d", hero.score), 10, 10, 20, WHITE)

        EndDrawing()

    CloseWindow()
    return 0