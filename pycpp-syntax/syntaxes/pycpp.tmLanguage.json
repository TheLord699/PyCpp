
{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "PyCPP",
    "scopeName": "source.pycpp",
    "fileTypes": ["pycpp"],

    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#decorators" },
        { "include": "#definitions" },
        { "include": "#keywords" },
        { "include": "#exceptions" },
        { "include": "#builtins" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#self" },
        { "include": "#operators" },
        { "include": "#function-calls" },
        { "include": "#attributes" },
        { "include": "#brackets" }
    ],

    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.python",
                    "match": "#.*$"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.python",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.python",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.python",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.python",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },

        "decorators": {
            "patterns": [
                {
                    "name": "meta.annotation.python",
                    "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.annotation.python"
                        },
                        "2": {
                            "name": "entity.name.function.decorator.python"
                        }
                    }
                }
            ]
        },

        "definitions": {
            "patterns": [
                {
                    "name": "meta.function.python",
                    "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.python"
                        },
                        "2": {
                            "name": "entity.name.function.python"
                        }
                    }
                },
                {
                    "name": "meta.class.python",
                    "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.class.python"
                        },
                        "2": {
                            "name": "entity.name.type.class.python"
                        }
                    }
                },
                {
                    "name": "meta.struct.pycpp",
                    "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.class.python"
                        },
                        "2": {
                            "name": "entity.name.type.class.python"
                        }
                    }
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.flow.python",
                    "match": "\\b(if|elif|else|for|while|break|continue|return|pass|try|except|finally|raise|match|case)\\b"
                },
                {
                    "name": "keyword.control.import.python",
                    "match": "\\b(import|from|as|use)\\b"
                },
                {
                    "name": "keyword.control.pycpp",
                    "match": "\\b(defer|unsafe)\\b"
                },
                {
                    "name": "keyword.operator.logical.python",
                    "match": "\\b(and|or|not|in|is)\\b"
                },
                {
                    "name": "keyword.other.python",
                    "match": "\\b(assert|del|global|nonlocal|lambda|yield|async|await)\\b"
                },
                {
                    "name": "storage.modifier.python",
                    "match": "\\b(const|constexpr|static|mutable)\\b"
                }
            ]
        },

        "exceptions": {
            "patterns": [
                {
                    "name": "support.type.exception.python",
                    "match": "\\b(BaseException|Exception|ArithmeticError|ZeroDivisionError|OverflowError|FloatingPointError|LookupError|IndexError|KeyError|ValueError|TypeError|RuntimeError|NameError|AttributeError|ImportError|ModuleNotFoundError|FileNotFoundError|OSError|IOError|AssertionError|StopIteration|MemoryError|SyntaxError|NotImplementedError)\\b"
                }
            ]
        },

        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.python",
                    "match": "\\b(print|input|len|range|sum|min|max|sorted|reversed|enumerate|zip|map|filter|any|all|abs|round|pow|divmod|bin|oct|hex|chr|ord|format|repr|hash|id|type|isinstance|issubclass|callable|iter|next|list|tuple|dict|set|frozenset|str|int|float|bool|bytes|bytearray|complex|object|super|property|staticmethod|classmethod|open|dir|vars|globals|locals|help|eval|exec|compile|memoryview|slice|ascii|breakpoint|randint)\\b"
                },
                {
                    "name": "support.function.builtin.pycpp",
                    "match": "\\bmem\\.(alloc|free)\\b"
                }
            ]
        },

        "types": {
            "patterns": [
                {
                    "name": "support.type.python",
                    "match": "\\b(void|auto|char|wchar_t|short|long|signed|unsigned|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|double)\\b"
                }
            ]
        },

        "constants": {
            "patterns": [
                {
                    "name": "constant.language.python",
                    "match": "\\b(True|False|None|true|false|nullptr)\\b"
                },
                {
                    "name": "constant.other.python",
                    "match": "\\b(NotImplemented|Ellipsis|__debug__)\\b"
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.python",
                    "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|\\d+(\\.\\d+)?([eE][+-]?\\d+)?)[jJ]?\\b"
                }
            ]
        },

        "self": {
            "patterns": [
                {
                    "name": "variable.language.python",
                    "match": "\\b(self|cls)\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.python",
                    "match": "\\+\\=|\\-\\=|\\*\\=|/\\=|//\\=|%\\=|&\\=|\\|\\=|\\^\\=|>>\\=|<<\\=|\\*\\*\\=|="
                },
                {
                    "name": "keyword.operator.comparison.python",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.arithmetic.python",
                    "match": "\\+|-|\\*\\*?|/|//|%|&|\\||\\^|~|<<|>>"
                },
                {
                    "name": "punctuation.separator.python",
                    "match": ",|:|;"
                }
            ]
        },

        "function-calls": {
            "patterns": [
                {
                    "name": "entity.name.function.python",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        },

        "attributes": {
            "patterns": [
                {
                    "name": "variable.other.member.python",
                    "match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },

        "brackets": {
            "patterns": [
                {
                    "name": "punctuation.section.group.begin.python",
                    "match": "\\("
                },
                {
                    "name": "punctuation.section.group.end.python",
                    "match": "\\)"
                },
                {
                    "name": "punctuation.section.brackets.begin.python",
                    "match": "\\["
                },
                {
                    "name": "punctuation.section.brackets.end.python",
                    "match": "\\]"
                },
                {
                    "name": "punctuation.section.block.begin.python",
                    "match": "\\{"
                },
                {
                    "name": "punctuation.section.block.end.python",
                    "match": "\\}"
                }
            ]
        }
    }
}
