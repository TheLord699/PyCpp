# expect-exit: 0
# expect-stdout: 10 7 [2, 4, 6]
# expect-stdout: 13
def make_adder(n: int) -> auto:
    return lambda x: x + n

def main() -> int:
    twice = lambda x: x * 2
    add = lambda a, b: a + b
    twiced = [twice(n) for n in [1, 2, 3]]
    print(twice(5), add(3, 4), twiced)
    add3 = make_adder(3)
    print(add3(10))
    return 0
