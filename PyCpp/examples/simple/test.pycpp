import math_utils

def greet(name: str) -> void:
    print("Hello, " + name)

def main() -> int:
    print("Hello from PyCPP")
    
    greeting: str = "Welcome to the test suite!"
    print(greeting)
    
    # Test math_utils imports
    result: int = math_utils.add(5, 10)
    print("5 + 10 = ")
    print(result)
    
    greet("Keith")
    return 0