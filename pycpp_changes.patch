+// Skip an INDENT ... DEDENT region (including any regions nested inside it).
+void PyCppParser::skipIndentedRegion() {
+    if (!check(TokenType::INDENT)) return;
+    int depth = 0;
+    while (!atEnd()) {
+        if (check(TokenType::INDENT)) {
+            depth++;
+        }
+        else if (check(TokenType::DEDENT)) {
+            depth--;
+            if (depth == 0) {
+                advance();
+                return;
+            }
+        }
+        advance();
+    }
